# ========================================================
# 「小嘉」图书馆AI智能体 (AssistantJia) 环境变量配置文件示例
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ========================================================

# 大语言模型配置 (DeepSeek / 通义千问 / OpenAI等兼容接口)
LLM_API_KEY=sk-your-llm-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 嵌入模型配置 (用于RAG向量检索)
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 向量数据库 Chroma 配置
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Redis 配置 (对话记忆缓存与高频结果缓存)
REDIS_URL=redis://localhost:6379/0

# 图书馆业务系统 (OPAC / 读者借阅系统) 接口配置
OPAC_BASE_URL=http://opac.example.edu.cn
OPAC_TIMEOUT_SECONDS=10

# 服务端配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
