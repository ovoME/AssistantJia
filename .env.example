# ========================================================
# 「小嘉」图书馆AI智能体 (AssistantJia) 环境变量配置文件示例
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ========================================================

# 大语言模型配置 (DeepSeek / 通义千问 / OpenAI等兼容接口)
LLM_API_KEY=sk-your-llm-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 嵌入模型配置 (用于RAG向量检索)
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 向量数据库 Chroma 配置
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Redis 配置 (对话记忆缓存与高频结果缓存)
REDIS_URL=redis://localhost:6379/0

# 图书馆业务系统 (OPAC / 读者借阅系统) 接口配置
OPAC_BASE_URL=http://opac.example.edu.cn
OPAC_TIMEOUT_SECONDS=10

# 服务端配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# C1/C2 历史借阅目录、C3 目录快照与公开规则摘要（相对路径从启动目录解析）
# 如需已提交的模拟联调数据，显式改为 integration；local 使用下方自备数据路径
DATA_PROFILE=local
DATA_DIRECTORY=./data/processed/service-demo
CATALOG_DATABASE=./data/processed/service-demo/catalog.sqlite3
KNOWLEDGE_SOURCE=./data/knowledge/rules.json
USAGE_REPORT=./data/processed/usage.json
# disabled 不执行实时借阅；demo 仅显式演示虚构在借/续借/预约，不联系馆方
OPAC_PROVIDER=disabled
# 管理端需至少16字符密钥；读者签名密钥至少32字符，实际值不要提交
ADMIN_TOKEN=
READER_TOKEN_SECRET=
COOKIE_SECURE=false
